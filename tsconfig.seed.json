{
  "compilerOptions": {
    "target": "ES2023",
    "rootDir": "./prisma/seed",
    "outDir": "./dist/seed",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["prisma/seed/**/*.ts"],
  "exclude": ["node_modules"]
}
