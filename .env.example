# Application
NODE_ENV=development
PORT=3000
APP_NAME=NovaCart
APP_URL=http://localhost:3000
API_PREFIX=api/v1

# Database (Neon / PostgreSQL)
# Local PostgreSQL (psql). Update user/password to match your install.
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/novacart?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret-32chars
JWT_REFRESH_EXPIRES_IN=7d

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Logging
LOG_LEVEL=info

# Seed
SEED_ADMIN_EMAIL=admin@novacart.com
SEED_ADMIN_PASSWORD=Admin@123456

# Image providers (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Nova AI (optional — falls back without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_ENABLED=true
